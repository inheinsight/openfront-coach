# Port for the local coach server and dashboard.
PORT=5317

# Where the coach keeps its database, cached game records and engine builds.
# DATA_DIR=./data

# Your OpenFront public player ID (shown on your OpenFront profile). Optional:
# the Chrome extension detects it automatically. When set, the coach can also
# import your recent games straight from the OpenFront API.
# OPENFRONT_PUBLIC_ID=

# Jev (TypeSafe System One model) judges each key moment with calibrated
# confidence. Get a key at https://console.typesafe.ai/keys. Optional.
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest

# Narrative debriefs are written by your local Claude Code CLI (`claude -p`),
# billed to your existing Claude subscription. Set to "off" to use templates.
# NARRATOR=claude-cli
# CLAUDE_MODEL=haiku
